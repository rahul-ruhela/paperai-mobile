{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "platforms": ["ios"],
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local",
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.28:5263",
        "EXPO_PUBLIC_APPLE_WEEKLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_weekly",
        "EXPO_PUBLIC_APPLE_MONTHLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_monthly",
        "EXPO_PUBLIC_APPLE_YEARLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_yearly"
      }
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "platforms": ["ios"],
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:5263",
        "EXPO_PUBLIC_APPLE_WEEKLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_weekly",
        "EXPO_PUBLIC_APPLE_MONTHLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_monthly",
        "EXPO_PUBLIC_APPLE_YEARLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_yearly"
      }
    },
    "preview": {
      "distribution": "internal",
      "platforms": ["ios"],
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://apis.bseptechnologies.com",
        "EXPO_PUBLIC_APPLE_WEEKLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_weekly",
        "EXPO_PUBLIC_APPLE_MONTHLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_monthly",
        "EXPO_PUBLIC_APPLE_YEARLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_yearly"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "platforms": ["ios"],
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://apis.bseptechnologies.com",
        "EXPO_PUBLIC_APPLE_WEEKLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_weekly",
        "EXPO_PUBLIC_APPLE_MONTHLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_monthly",
        "EXPO_PUBLIC_APPLE_YEARLY_PRODUCT_ID": "com.bholeshankar.paperai.pro_yearly"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "rahulruhela.net@gmail.com",
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      }
    }
  }
}
