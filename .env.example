# ============================================================
# PaperAI Mobile – Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to git.
# ============================================================

# Environment name: local | staging | production
EXPO_PUBLIC_APP_ENV=local

# API base URL (no trailing slash)
# local dev:    http://YOUR_LOCAL_IP:5263   (your machine's LAN IP, so a real
#               device on the same Wi-Fi can reach the local API)
# staging:      https://apis.bseptechnologies.com
# production:   https://apis.bseptechnologies.com
# Unset -> the app defaults to the production API.
# EXPO_PUBLIC_API_BASE_URL=http://10.112.12.8:5263
# EXPO_PUBLIC_API_BASE_URL=http://192.168.29.187:5263
EXPO_PUBLIC_API_BASE_URL=https://apis.bseptechnologies.com



# NOTE: In-app purchase product IDs are NOT configured here. The catalog lives
# in src/constants/api.ts (SUBSCRIPTION_TIERS) and must match App Store Connect
# and the backend's IAP:Products config exactly.
