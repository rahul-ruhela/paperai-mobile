# ============================================================
# PaperAI Mobile – Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to git.
# ============================================================

# Environment name: local | staging | production
EXPO_PUBLIC_APP_ENV=local

# API base URL (no trailing slash)
# local dev:    http://YOUR_LOCAL_IP:5263
# staging:      https://apis.bseptechnologies.com
# production:   https://apis.bseptechnologies.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.28:5263

# Apple In-App Purchase Product IDs (must match App Store Connect exactly)
EXPO_PUBLIC_APPLE_WEEKLY_PRODUCT_ID=com.bholeshankar.paperai.pro_weekly
EXPO_PUBLIC_APPLE_MONTHLY_PRODUCT_ID=com.bholeshankar.paperai.pro_monthly
EXPO_PUBLIC_APPLE_YEARLY_PRODUCT_ID=com.bholeshankar.paperai.pro_yearly

# Android Billing Product IDs (future – leave blank for now)
# EXPO_PUBLIC_GOOGLE_WEEKLY_PRODUCT_ID=
# EXPO_PUBLIC_GOOGLE_MONTHLY_PRODUCT_ID=
# EXPO_PUBLIC_GOOGLE_YEARLY_PRODUCT_ID=
