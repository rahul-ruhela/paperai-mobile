{
  "expo": {
    "name": "Paper Ai Assistant",
    "slug": "paperai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bholeshankar.paperai",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Paper AI Assistant needs access to your photo library to let you select images for text extraction and document scanning."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Paper AI Assistant needs camera access to scan documents and extract text.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Paper AI Assistant needs access to your full photo library to scan for duplicate photos and free up storage. Select \"All Photos\" so Junk Wiper can find all duplicates.",
          "savePhotosPermission": "Paper AI Assistant needs permission to save scanned documents to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "b0bec626-8107-4130-95be-749068adbcd7"
      }
    },

    "owner": "rahulruhela",
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
